# syntax=docker/dockerfile:1.7
{#- 
   NOTE: Editable installation now happens not in build phase but at runtime in run.sh before running tests,
   since the repo is bind-mounted and cannot be reliably pip editable installed during build.
#}

ARG PYTHON_VERSION={{ python_version_tag }}
FROM python:${PYTHON_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
{% for k, v in env_vars.items() %}
ENV {{ k }}="{{ v }}"
{%- endfor %}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

{% if project_apt_packages and project_apt_packages|length > 0 %}
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
{%- for p in project_apt_packages %}
      {{ p }} \
{%- endfor %}
    && rm -rf /var/lib/apt/lists/*
{%- endif %}

ARG APP_USER={{ app_user }}
RUN useradd -m ${APP_USER} && mkdir -p {{ mount_dir }} && chown -R ${APP_USER}:${APP_USER} {{ mount_dir }}
USER ${APP_USER}
ENV XDG_CACHE_HOME=/home/${APP_USER}/.cache

# Separate step of upgrade pip for better caching
RUN --mount=type=cache,target=/home/${APP_USER}/.cache/pip \
    bash -lc 'set -euo pipefail; \
      python -m pip install --upgrade pip; \
      true'

# NOTE: The docker build context IS the repo root, so source is simply "."
RUN --mount=type=cache,target=/home/${APP_USER}/.cache/pip \
    --mount=type=bind,source=.,target={{ mount_dir }},rw \
    bash -lc 'set -euo pipefail; \
      cd "{{ test_workdir }}"; \
{%- for step in pip_deps %}
      echo "+ pip install {{ step }}"; \
      pip install {{ step }}; \
{%- endfor %}
      true'

# Enforce installation of pytest, pytest-cov, coverage, so that testing agent can obtain coverage report of pytest
# Only install pytest, pytest-cov, coverage if original repo doesn't have it
RUN --mount=type=cache,target=/home/${APP_USER}/.cache/pip \
    bash -lc 'set -euo pipefail; \
      echo "+ install pytest, pytest-cov, coverage only if not already installed"; \
      python -c "import pytest" || { echo "+ pip install pytest" && pip install pytest; }; \
      python -c "import pytest_cov" || { echo "+ pip install pytest-cov" && pip install pytest-cov; }; \
      python -c "import coverage" || { echo "+ pip install coverage" && pip install coverage; }; \
      true'

WORKDIR {{ test_workdir }}
{% set _cmd = (test_cmd | default(["python","-m","pytest"])) %}
CMD {{ _cmd | tojson }}
